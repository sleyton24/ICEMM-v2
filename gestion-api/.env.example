# ── gestion-api / .env.example ───────────────────────────────────────────────
# Copiar a .env y completar. NUNCA commitear el .env real.

# PostgreSQL: base NUEVA llamada "gestion" (independiente de ICEMM).
DATABASE_URL="postgresql://gestion:CAMBIAR_CLAVE@localhost:5432/gestion?schema=public"

# Puerto del backend (Nginx hará proxy_pass desde /api/). Default del código: 3002.
PORT=3002

# === OBLIGATORIO ===
# Secret para firmar JWT. Mínimo 32 caracteres y DEBE ser aleatorio.
# El backend ABORTA el arranque si falta, es un placeholder o tiene <32 chars.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# CORS origins (separados por coma). NUNCA usar '*' con credentials:true.
# Listar SOLO los orígenes reales del frontend.
CORS_ORIGIN=https://gestion.187.127.29.98.nip.io

# === BETA MODE ===
# true  → cualquiera con la URL puede usar la app (SIN LOGIN, bypass total de auth).
#         Solo para QA en entornos cerrados. NUNCA exponer así a internet.
# false → requiere JWT (login real). VALOR POR DEFECTO Y OBLIGATORIO en producción.
BETA_MODE=false
